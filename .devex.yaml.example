# DevEx CLI configuration — generated by 'devex init'
# Docs: https://github.com/BCPathway/devex-cli#configuration

project:
  name: my-project
  repository_url: https://github.com/your-org/your-repo

drips:
  # Ethereum JSON-RPC endpoint (Optimism mainnet by default).
  # Override with DRIPS_NETWORK_RPC or DEVEX_DRIPS_RPC_ENDPOINT env var.
  rpc_endpoint: https://mainnet.optimism.io

  # Chain ID: 10 = Optimism Mainnet, 11155420 = Optimism Sepolia
  chain_id: 10

  # Wallet address for querying Drips state.
  # Override with DRIPS_WALLET_ADDRESS env var.
  wallet_address: ""

  # Private key for write operations (splits, streams).
  # ⚠️  NEVER commit this — use DRIPS_PRIVATE_KEY env var instead.
  # private_key: ""

stellar:
  # Stellar Horizon REST API endpoint (Testnet by default).
  # Override with STELLAR_HORIZON_URL env var.
  horizon_url: https://horizon-testnet.stellar.org

  # Project Stellar account ID (G... public key).
  # Override with STELLAR_ACCOUNT_ID env var.
  account_id: ""

  # Stellar network passphrase.
  network_passphrase: "Test SDF Network ; September 2015"

  # Secret key for write operations (multi-payment distributions).
  # ⚠️  NEVER commit this — use STELLAR_SECRET_KEY env var or keychain instead.
  # secret_key: ""

dev:
  # Command to start the local development environment.
  start_command: docker compose up

  # Optional: services to start (if using selective startup).
  services:
    - api
    - db
    - redis
